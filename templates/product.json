ject-position:center center;background:#000}\n.df-sound-icon{position:absolute;left:16px;bottom:16px;width:44px;height:44px;border-radius:999px;background:rgba(0,0,0,0.48);color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-size:18px;backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.35);pointer-events:none}\n.df-video-modal{position:fixed;inset:0;z-index:999999;display:none;align-items:center;justify-content:center;padding:22px;background:rgba(5,10,20,0.82);backdrop-filter:blur(10px)}\n.df-video-modal.is-open{display:flex}\n.df-video-modal-inner{position:relative;width:min(430px,92vw);aspect-ratio:9/16;border-radius:26px;overflow:hidden;background:#000;box-shadow:0 30px 90px rgba(0,0,0,0.45)}\n.df-video-modal-inner video{width:100%;height:100%;object-fit:contain;background:#000}\n.df-video-modal-close{position:fixed;top:22px;right:22px;z-index:1000000;width:46px;height:46px;border-radius:999px;border:none;background:rgba(255,255,255,0.96);color:#071827;font-size:34px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 14px 35px rgba(0,0,0,0.25)}\n@media screen and (max-width:749px){\n.df-video-only-section{padding:24px 0}\n.df-video-only-grid{display:flex;gap:14px;overflow-x:auto;padding:0 16px 10px;scrollbar-width:none;scroll-snap-type:x mandatory}\n.df-video-only-grid::-webkit-scrollbar{display:none}\n.df-video-only-card{min-width:78%;scroll-snap-align:center;border-radius:18px}\n.df-sound-icon{width:40px;height:40px;font-size:16px;left:14px;bottom:14px}\n.df-video-modal{padding:14px}\n.df-video-modal-inner{width:94vw;border-radius:22px}\n.df-video-modal-close{top:14px;right:14px;width:42px;height:42px;font-size:30px}\n}\n</style>\n<script>\n(function(){\nfunction initDfVideoOnly(){\nvar cards=document.querySelectorAll(\".df-video-only-card\");\nvar modal=document.getElementById(\"dfVideoModal\");\nvar modalVideo=document.getElementById(\"dfVideoModalPlayer\");\nvar closeBtn=document.querySelector(\".df-video-modal-close\");\nif(!modal||!modalVideo||!closeBtn)return;\ncards.forEach(function(card){\nif(card.dataset.dfVideoInit===\"true\")return;\ncard.dataset.dfVideoInit=\"true\";\nvar previewVideo=card.querySelector(\"video\");\nvar videoSrc=card.getAttribute(\"data-video-src\");\nif(!previewVideo||!videoSrc)return;\npreviewVideo.muted=true;\npreviewVideo.play().catch(function(){});\ncard.addEventListener(\"click\",function(){\ndocument.querySelectorAll(\".df-video-only-card video\").forEach(function(v){v.muted=true;});\nmodalVideo.src=videoSrc;modalVideo.muted=false;modalVideo.currentTime=0;\nmodal.classList.add(\"is-open\");document.body.style.overflow=\"hidden\";\nmodalVideo.play().catch(function(){});\n});\n});\nif(modal.dataset.dfInit===\"true\")return;\nmodal.dataset.dfInit=\"true\";\nfunction closeModal(){modal.classList.remove(\"is-open\");modalVideo.pause();modalVideo.removeAttribute(\"src\");modalVideo.load();document.body.style.overflow=\"\";}\ncloseBtn.addEventListener(\"click\",closeModal);\nmodal.addEventListener(\"click\",function(e){if(e.target===modal){closeModal();}});\ndocument.addEventListener(\"keydown\",function(e){if(e.key===\"Escape\"&&modal.classList.contains(\"is-open\")){closeModal();}});\n}\nif(document.readyState===\"loading\"){document.addEventListener(\"DOMContentLoaded\",initDfVideoOnly);}else{initDfVideoOnly();}\ndocument.addEventListener(\"shopify:section:load\",initDfVideoOnly);\n})();\n</script>"
