eview-prev {\n    left: 14px;\n  }\n\n  .df-review-next {\n    right: 14px;\n  }\n\n  @media screen and (max-width: 749px) {\n    .df-reviews-section {\n      padding: 54px 0 58px;\n    }\n\n    .df-reviews-header {\n      margin-bottom: 28px;\n      padding: 0 18px;\n    }\n\n    .df-reviews-header h2 {\n      font-size: 33px;\n      letter-spacing: -1.2px;\n    }\n\n    .df-reviews-header p:not(.df-reviews-kicker) {\n      font-size: 14.5px;\n      line-height: 1.45;\n    }\n\n    .df-reviews-wrapper {\n      padding: 0 16px;\n    }\n\n    .df-reviews-slider {\n      gap: 16px;\n      padding-bottom: 22px;\n    }\n\n    .df-review-card {\n      width: 275px;\n      min-width: 275px;\n      border-radius: 20px;\n    }\n\n    .df-review-card img {\n      height: 240px;\n    }\n\n    .df-review-content {\n      padding: 18px 18px 20px;\n    }\n\n    .df-review-content h3 {\n      font-size: 15.5px;\n    }\n\n    .df-review-content p {\n      font-size: 13.5px;\n      line-height: 1.48;\n    }\n\n    .df-review-arrow {\n      width: 38px;\n      height: 38px;\n      font-size: 28px;\n      top: 52%;\n    }\n\n    .df-review-prev {\n      left: 4px;\n    }\n\n    .df-review-next {\n      right: 4px;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  function initDfReviewsSlider() {\n    const slider = document.getElementById(\"dfReviewsSlider\");\n    const prev = document.querySelector(\".df-review-prev\");\n    const next = document.querySelector(\".df-review-next\");\n\n    if (!slider || !prev || !next) return;\n    if (slider.dataset.dfInit === \"true\") return;\n\n    slider.dataset.dfInit = \"true\";\n\n    let isPaused = false;\n\n    function getGap() {\n      return window.innerWidth < 750 ? 16 : 22;\n    }\n\n    function getScrollAmount() {\n      const card = slider.querySelector(\".df-review-card\");\n      if (!card) return 320;\n      return card.offsetWidth + getGap();\n    }\n\n    function getLoopPoint() {\n      return slider.scrollWidth / 2;\n    }\n\n    function autoMove() {\n      if (!isPaused) {\n        slider.scrollLeft += 0.8;\n\n        if (slider.scrollLeft >= getLoopPoint()) {\n          slider.scrollLeft = 0;\n        }\n      }\n\n      requestAnimationFrame(autoMove);\n    }\n\n    next.addEventListener(\"click\", function () {\n      isPaused = true;\n\n      slider.scrollBy({\n        left: getScrollAmount(),\n        behavior: \"smooth\"\n      });\n\n      setTimeout(function () {\n        isPaused = false;\n      }, 1200);\n    });\n\n    prev.addEventListener(\"click\", function () {\n      isPaused = true;\n\n      slider.scrollBy({\n        left: -getScrollAmount(),\n        behavior: \"smooth\"\n      });\n\n      setTimeout(function () {\n        isPaused = false;\n      }, 1200);\n    });\n\n    slider.addEventListener(\"mouseenter\", function () {\n      isPaused = true;\n    });\n\n    slider.addEventListener(\"mouseleave\", function () {\n      isPaused = false;\n    });\n\n    slider.addEventListener(\"touchstart\", function () {\n      isPaused = true;\n    });\n\n    slider.addEventListener(\"touchend\", function () {\n      setTimeout(function () {\n        isPaused = false;\n      }, 1500);\n    });\n\n    autoMove();\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", initDfReviewsSlider);\n  } else {\n    initDfReviewsSlider();\n  }\n\n  document.addEventListener(\"shopify:section:load\", initDfReviewsSlider);\n})();\n</script>",
