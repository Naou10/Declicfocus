        "liquid": "<section class=\"df-video-testimonials\">\n  <div class=\"df-video-inner\">\n\n    <div class=\"df-video-header\">\n      <h2>Ils utilisent Déclic Focus au quotidien</h2>\n      <p>Découvrez comment nos clients l’intègrent dans leurs sessions de travail, de révision ou d’organisation.</p>\n    </div>\n\n    <div class=\"df-video-grid\">\n\n      <div class=\"df-video-card\">\n        <video class=\"df-video\" preload=\"metadata\" playsinline>\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/95365ca7acac437980a48d90b03d194c.mov\" type=\"video/mp4\">\n        </video>\n        <button class=\"df-play-button\" type=\"button\" aria-label=\"Lire la vidéo\">\n          ▶\n        </button>\n      </div>\n\n      <div class=\"df-video-card\">\n        <video class=\"df-video\" preload=\"metadata\" playsinline>\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/bd452c8fcd7843ae8086a5295b8ce669.mov\" type=\"video/mp4\">\n        </video>\n        <button class=\"df-play-button\" type=\"button\" aria-label=\"Lire la vidéo\">\n          ▶\n        </button>\n      </div>\n\n      <div class=\"df-video-card\">\n        <video class=\"df-video\" preload=\"metadata\" playsinline>\n          <source src=\"https://cdn.shopify.com/videos/c/o/v/38c2aaf395ed43cc94dce3446a03d31d.mov\" type=\"video/mp4\">\n        </video>\n        <button class=\"df-play-button\" type=\"button\" aria-label=\"Lire la vidéo\">\n          ▶\n        </button>\n      </div>\n\n    </div>\n\n  </div>\n</section>\n\n<style>\n  .df-video-testimonials {\n    width: 100%;\n    padding: 70px 0;\n    background: #F5F7FA;\n    font-family: Inter, Arial, Helvetica, sans-serif;\n  }\n\n  .df-video-inner {\n    max-width: 1180px;\n    margin: 0 auto;\n    padding: 0 22px;\n  }\n\n  .df-video-header {\n    text-align: center;\n    max-width: 760px;\n    margin: 0 auto 38px;\n  }\n\n  .df-video-header h2 {\n    margin: 0;\n    color: #071827;\n    font-size: clamp(30px, 4vw, 46px);\n    line-height: 1.05;\n    font-weight: 900;\n    letter-spacing: -1.3px;\n  }\n\n  .df-video-header p {\n    margin: 14px auto 0;\n    color: #475569;\n    font-size: 17px;\n    line-height: 1.45;\n    font-weight: 500;\n  }\n\n  .df-video-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 28px;\n  }\n\n  .df-video-card {\n    position: relative;\n    aspect-ratio: 9 / 16;\n    border-radius: 22px;\n    overflow: hidden;\n    background: #DDE4EE;\n    box-shadow: 0 22px 55px rgba(15, 23, 42, 0.18);\n  }\n\n  .df-video-card video {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    background: #000;\n  }\n\n  .df-play-button {\n    position: absolute;\n    left: 22px;\n    bottom: 22px;\n    width: 58px;\n    height: 58px;\n    border-radius: 999px;\n    border: 2px solid rgba(255, 255, 255, 0.95);\n    background: rgba(0, 0, 0, 0.42);\n    backdrop-filter: blur(8px);\n    color: #FFFFFF;\n    font-size: 24px;\n    line-height: 1;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding-left: 4px;\n    transition: transform 0.2s ease, background 0.2s ease, opacity 0.2s ease;\n  }\n\n  .df-play-button:hover {\n    transform: scale(1.06);\n    background: rgba(0, 0, 0, 0.58);\n  }\n\n  .df-video-card.is-playing .df-play-button {\n    opacity: 0;\n    pointer-events: none;\n  }\n\n  @media screen and (max-width: 749px) {\n    .df-video-testimonials {\n      padding: 54px 0;\n    }\n\n    .df-video-inner {\n      padding: 0 16px;\n    }\n\n    .df-video-header {\n      margin-bottom: 28px;\n    }\n\n    .df-video-header h2 {\n      font-size: 32px;\n      letter-spacing: -1px;\n    }\n\n    .df-video-header p {\n      font-size: 14.5px;\n    }\n\n    .df-video-grid {\n      display: flex;\n      gap: 16px;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      padding-bottom: 10px;\n      scrollbar-width: none;\n    }\n\n    .df-video-grid::-webkit-scrollbar {\n      display: none;\n    }\n\n    .df-video-card {\n      min-width: 78%;\n      border-radius: 20px;\n      scroll-snap-align: center;\n    }\n\n    .df-play-button {\n      width: 52px;\n      height: 52px;\n      left: 18px;\n      bottom: 18px;\n      font-size: 21px;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    function initDfVideos() {\n      const cards = document.querySelectorAll(\".df-video-card\");\n\n      cards.forEach(function (card) {\n        if (card.dataset.videoInit === \"true\") return;\n        card.dataset.videoInit = \"true\";\n\n        const video = card.querySelector(\"video\");\n        const button = card.querySelector(\".df-play-button\");\n\n        if (!video || !button) return;\n\n        button.addEventListener(\"click\", function () {\n          document.querySelectorAll(\".df-video-card video\").forEach(function (otherVideo) {\n            if (otherVideo !== video) {\n              otherVideo.pause();\n              otherVideo.closest(\".df-video-card\")?.classList.remove(\"is-playing\");\n            }\n          });\n\n          video.play();\n          card.classList.add(\"is-playing\");\n        });\n\n        video.addEventListener(\"click\", function () {\n          if (video.paused) {\n            document.querySelectorAll(\".df-video-card video\").forEach(function (otherVideo) {\n              if (otherVideo !== video) {\n                otherVideo.pause();\n                otherVideo.closest(\".df-video-card\")?.classList.remove(\"is-playing\");\n              }\n            });\n\n            video.play();\n            card.classList.add(\"is-playing\");\n          } else {\n            video.pause();\n            card.classList.remove(\"is-playing\");\n          }\n        });\n\n        video.addEventListener(\"ended\", function () {\n          card.classList.remove(\"is-playing\");\n        });\n      });\n    }\n\n    if (document.readyState === \"loading\") {\n      document.addEventListener(\"DOMContentLoaded\", initDfVideos);\n    } else {\n      initDfVideos();\n    }\n\n    document.addEventListener(\"shopify:section:load\", initDfVideos);\n  })();\n</script>",
