ng>\n      </span>\n    </div>\n  </div>\n</div>\n\n<style>\n  .df-trust-reassurance-box {\n    width: 100%;\n    max-width: 680px;\n    margin: 18px auto;\n    padding: 24px 28px;\n    background: transparent;\n    border: none;\n    border-radius: 0;\n    font-family: Arial, Helvetica, sans-serif;\n    color: #0F172A;\n  }\n\n  .df-reassurance-top {\n    display: grid;\n    grid-template-columns: 1fr auto 1fr auto 1fr;\n    align-items: center;\n    gap: 20px;\n  }\n\n  .df-reassurance-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    text-align: center;\n    min-width: 0;\n  }\n\n  .df-reassurance-icon {\n    width: 36px;\n    height: 36px;\n    flex-shrink: 0;\n    color: #183B44;\n  }\n\n  .df-reassurance-icon svg {\n    width: 36px;\n    height: 36px;\n    fill: none;\n    stroke: currentColor;\n    stroke-width: 1.9;\n    stroke-linecap: round;\n    stroke-linejoin: round;\n  }\n\n  .df-reassurance-item p {\n    margin: 0;\n    font-size: 16px;\n    font-weight: 850;\n    line-height: 1.08;\n    letter-spacing: -0.25px;\n    color: #0B1220;\n  }\n\n  .df-reassurance-divider {\n    width: 1px;\n    height: 70px;\n    background: #E2E8F0;\n  }\n\n  .df-trust-divider {\n    width: 100%;\n    height: 1px;\n    background: #E2E8F0;\n    margin: 28px 0 24px;\n  }\n\n  .df-trustpilot-section {\n    text-align: center;\n  }\n\n  .df-trustpilot-line {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 14px;\n    margin-bottom: 14px;\n  }\n\n  .df-trustpilot-label {\n    font-size: 20px;\n    font-weight: 900;\n    letter-spacing: -0.4px;\n    color: #050505;\n  }\n\n  .df-stars {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n  }\n\n  .df-stars span {\n    width: 30px;\n    height: 30px;\n    background: #00B67A;\n    color: #FFFFFF;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    font-size: