eviews-wrapper {\n    position: relative;\n    width: 100%;\n    max-width: 1380px;\n    margin: 0 auto;\n    padding: 0 72px;\n  }\n\n  .df-reviews-slider {\n    display: flex;\n    gap: 22px;\n    overflow-x: auto;\n    scroll-behavior: smooth;\n    padding: 8px 4px 26px;\n    scrollbar-width: none;\n  }\n\n  .df-reviews-slider::-webkit-scrollbar {\n    display: none;\n  }\n\n  .df-review-card {\n    width: 325px;\n    min-width: 325px;\n    overflow: hidden;\n    border-radius: 24px;\n    background: #FFFFFF;\n    box-shadow: 0 26px 70px rgba(0, 0, 0, 0.32);\n    border: 1px solid rgba(255, 255, 255, 0.46);\n    flex-shrink: 0;\n  }\n\n  .df-review-card img {\n    width: 100%;\n    height: 285px;\n    display: block;\n    object-fit: cover;\n    background: #E5E7EB;\n  }\n\n  .df-review-content {\n    padding: 20px 20px 22px;\n  }\n\n  .df-review-stars {\n    margin-bottom: 10px;\n    color: #00B67A;\n    font-size: 17px;\n    letter-spacing: 1.5px;\n    line-height: 1;\n  }\n\n  .df-review-content h3 {\n    margin: 0 0 10px;\n    color: #071827;\n    font-size: 17px;\n    line-height: 1.15;\n    font-weight: 900;\n    letter-spacing: -0.35px;\n  }\n\n  .df-review-content p {\n    margin: 0;\n    color: #243244;\n    font-size: 14.5px;\n    line-height: 1.5;\n    font-weight: 500;\n  }\n\n  .df-review-arrow {\n    position: absolute;\n    top: 46%;\n    transform: translateY(-50%);\n    z-index: 5;\n    width: 48px;\n    height: 48px;\n    border-radius: 999px;\n    border: 1px solid rgba(255, 255, 255, 0.22);\n    background: rgba(255, 255, 255, 0.96);\n    color: #0B2447;\n    font-size: 36px;\n    line-height: 1;\n    font-weight: 500;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);\n    transition: transform 0.2s ease, background 0.2s ease;\n  }\n\n  .df-review-arrow:hover {\n    transform: translateY(-50%) scale(1.06);\n    background: #FFFFFF;\n  }\n\n  .df-review-prev {\n    left: 14px;\n  }\n\n  .df-review-next {\n    right: 14px;\n  }\n\n  @media screen and (max-width: 749px) {\n    .df-reviews-section {\n      padding: 54px 0 58px;\n    }\n\n    .df-reviews-header {\n      margin-bottom: 28px;\n      padding: 0 18px;\n    }\n\n    .df-reviews-header h2 {\n      font-size: 33px;\n      letter-spacing: -1.2px;\n    }\n\n    .df-reviews-header p:not(.df-reviews-kicker) {\n      font-size: 14.5px;\n      line-height: 1.45;\n    }\n\n    .df-reviews-wrapper {\n      padding: 0 16px;\n    }\n\n    .df-reviews-slider {\n      gap: 16px;\n      padding-bottom: 22px;\n    }\n\n    .df-review-card {\n      width: 275px;\n      min-width: 275px;\n      border-radius: 20px;\n    }\n\n    .df-review-card img {\n      height: 240px;\n    }\n\n    .df-review-content {\n      padding: 18px 18px 20px;\n    }\n\n    .df-review-content h3 {\n      font-size: 15.5px;\n    }\n\n    .df-review-content p {\n      font-size: 13.5px;\n      line-height: 1.48;\n    }\n\n    .df-review-arrow {\n      width: 38px;\n      height: 38px;\n      font-size: 28px;\n      top: 52%;\n    }\n\n    .df-review-prev {\n      left: 4px;\n    }\n\n    .df-review-next {\n      right: 4px;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  function initDfReviewsSlider() {\n    const slider = document.getElementById(\"dfReviewsSlider\");\n    const prev = document.querySelector(\".df-review-prev\");\n    const next = document.querySelector(\".df-review-next\");\n\n    if (!slider || !prev || !next) return;\n    if (slider.dataset.dfInit === \"true\") return;\n\n    slider.dataset.dfInit = \"true\";\n\n    let isPaused = false;\n\n    function getGap() {\n      return window.innerWidth < 750 ? 16 : 22;\n    }\n\n    function getScrollAmount() {\n      const card = slider.querySelector(\".df-review-card\");\n      if (!card) return 320;\n      return card.offsetWidth + getGap();\n    }\n\n    function getLoopPoint() {\n      return slider.scrollWidth / 2;\n    }\n\n    function autoMove() {\n      if (!isPaused) {\n        slider.scrollLeft += 0.8;\n\n        if (slider.scrollLeft >= getLoopPoint()) {\n          slider.scrollLeft = 0;\n        }\n      }\n\n      requestAnimationFrame(autoMove);\n    }\n\n    next.addEventListener(\"click\", function () {\n      isPaused = true;\n\n      slider.scrollBy({\n        left: getScrollAmount(),\n        behavior: \"smooth\"\n      });\n\n      setTimeout(function () {\n        isPaused = false;\n      }, 1200);\n    });\n\n    prev.addEventListener(\"click\", function () {\n      isPaused = true;\n\n      slider.scrollBy({\n        left: -getScrollAmount(),\n        behavior: \"smooth\"\n      });\n\n      setTimeout(function () {\n        isPaused = false;\n      }, 1200);\n    });\n\n    slider.addEventListener(\"mouseenter\", function () {\n      isPaused = true;\n    });\n\n    slider.addEventListener(\"mouseleave\", function () {\n      isPaused = false;\n    });\n\n    slider.addEventListener(\"touchstart\", function () {\n      isPaused = true;\n    });\n\n    slider.addEventListener(\"touchend\", function () {\n      setTimeout(function () {\n        isPaused = false;\n      }, 1500);\n    });\n\n    autoMove();\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", initDfReviewsSlider);\n  } else {\n    initDfReviewsSlider();\n  }\n\n  document.addEventListener(\"shopify:section:load\", initDfReviewsSlider);\n})();\n</script>",
