  margin: 0 auto;\n    padding: 0 20px;\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 24px;\n  }\n\n  .df-video-only-card {\n    position: relative;\n    aspect-ratio: 9 / 16;\n    border-radius: 22px;\n    overflow: hidden;\n    background: #E5E7EB;\n    box-shadow: 0 14px 40px rgba(15, 23, 42, 0.12);\n    cursor: pointer;\n  }\n\n  .df-video-only-card video {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    object-position: center center;\n    background: #000;\n  }\n\n  .df-video-card-contain video {\n    object-fit: contain;\n    object-position: center center;\n    background: #000;\n  }\n\n  .df-sound-icon {\n    position: absolute;\n    left: 16px;\n    bottom: 16px;\n    width: 44px;\n    height: 44px;\n    border-radius: 999px;\n    background: rgba(0, 0, 0, 0.48);\n    color: #FFFFFF;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 18px;\n    backdrop-filter: blur(8px);\n    border: 1px solid rgba(255, 255, 255, 0.35);\n    pointer-events: none;\n  }\n\n  .df-video-modal {\n    position: fixed;\n    inset: 0;\n    z-index: 999999;\n    display: none;\n    align-items: center;\n    justify-content: center;\n    padding: 22px;\n    background: rgba(5, 10, 20, 0.82);\n    backdrop-filter: blur(10px);\n  }\n\n  .df-video-modal.is-open {\n    display: flex;\n  }\n\n  .df-video-modal-inner {\n    position: relative;\n    width: min(430px, 92vw);\n    aspect-ratio: 9 / 16;\n    border-radius: 26px;\n    overflow: hidden;\n    background: #000;\n    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.45);\n  }\n\n  .df-video-modal-inner video {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    background: #000;\n  }\n\n  .df-video-modal-close {\n    position: fixed;\n    top: 22px;\n    right: 22px;\n    z-index: 1000000;\n    width: 46px;\n    height: 46px;\n    border-radius: 999px;\n    border: none;\n    background: rgba(255, 255, 255, 0.96);\n    color: #071827;\n    font-size: 34px;\n    line-height: 1;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.25);\n  }\n\n  @media screen and (max-width: 749px) {\n    .df-video-only-section {\n      padding: 24px 0;\n    }\n\n    .df-video-only-grid {\n      display: flex;\n      gap: 14px;\n      overflow-x: auto;\n      padding: 0 16px 10px;\n      scrollbar-width: none;\n      scroll-snap-type: x mandatory;\n    }\n\n    .df-video-only-grid::-webkit-scrollbar {\n      display: none;\n    }\n\n    .df-video-only-card {\n      min-width: 78%;\n      scroll-snap-align: center;\n      border-radius: 18px;\n    }\n\n    .df-sound-icon {\n      width: 40px;\n      height: 40px;\n      font-size: 16px;\n      left: 14px;\n      bottom: 14px;\n    }\n\n    .df-video-modal {\n      padding: 14px;\n    }\n\n    .df-video-modal-inner {\n      width: 94vw;\n      border-radius: 22px;\n    }\n\n    .df-video-modal-close {\n      top: 14px;\n      right: 14px;\n      width: 42px;\n      height: 42px;\n      font-size: 30px;\n    }\n  }\n</style>\n\n<script>\n(function () {\n  function initDfVideoOnly() {\n    const cards = document.querySelectorAll(\".df-video-only-card\");\n    const modal = document.getElementById(\"dfVideoModal\");\n    const modalVideo = document.getElementById(\"dfVideoModalPlayer\");\n    const closeBtn = document.querySelector(\".df-video-modal-close\");\n\n    if (!modal || !modalVideo || !closeBtn) return;\n\n    cards.forEach(function (card) {\n      if (card.dataset.dfVideoInit === \"true\") return;\n      card.dataset.dfVideoInit = \"true\";\n\n      const previewVideo = card.querySelector(\"video\");\n      const videoSrc = card.getAttribute(\"data-video-src\");\n\n      if (!previewVideo || !videoSrc) return;\n\n      previewVideo.muted = true;\n      previewVideo.play().catch(function () {});\n\n      card.addEventListener(\"click\", function () {\n        document.querySelectorAll(\".df-video-only-card video\").forEach(function (video) {\n          video.muted = true;\n        });\n\n        modalVideo.src = videoSrc;\n        modalVideo.muted = false;\n        modalVideo.currentTime = 0;\n\n        modal.classList.add(\"is-open\");\n        document.body.style.overflow = \"hidden\";\n\n        modalVideo.play().catch(function () {});\n      });\n    });\n\n    function closeModal() {\n      modal.classList.remove(\"is-open\");\n      modalVideo.pause();\n      modalVideo.removeAttribute(\"src\");\n      modalVideo.load();\n      document.body.style.overflow = \"\";\n    }\n\n    closeBtn.addEventListener(\"click\", closeModal);\n\n    modal.addEventListener(\"click\", function (event) {\n      if (event.target === modal) {\n        closeModal();\n      }\n    });\n\n    document.addEventListener(\"keydown\", function (event) {\n      if (event.key === \"Escape\" && modal.classList.contains(\"is-open\")) {\n        closeModal();\n      }\n    });\n  }\n\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", initDfVideoOnly);\n  } else {\n    initDfVideoOnly();\n  }\n\n  document.addEventListener(\"shopify:section:load\", initDfVideoOnly);\n})();\n</script>"
