w, 46px);\n    line-height: 1.05;\n    font-weight: 900;\n    letter-spacing: -1.3px;\n  }\n\n  .df-video-header p {\n    margin: 14px auto 0;\n    color: #475569;\n    font-size: 17px;\n    line-height: 1.45;\n    font-weight: 500;\n  }\n\n  .df-video-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 28px;\n  }\n\n  .df-video-card {\n    position: relative;\n    aspect-ratio: 9 / 16;\n    border-radius: 22px;\n    overflow: hidden;\n    background: #DDE4EE;\n    box-shadow: 0 22px 55px rgba(15, 23, 42, 0.18);\n  }\n\n  .df-video-card video {\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    background: #000;\n  }\n\n  .df-play-button {\n    position: absolute;\n    left: 22px;\n    bottom: 22px;\n    width: 58px;\n    height: 58px;\n    border-radius: 999px;\n    border: 2px solid rgba(255, 255, 255, 0.95);\n    background: rgba(0, 0, 0, 0.42);\n    backdrop-filter: blur(8px);\n    color: #FFFFFF;\n    font-size: 24px;\n    line-height: 1;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding-left: 4px;\n    transition: transform 0.2s ease, background 0.2s ease, opacity 0.2s ease;\n  }\n\n  .df-play-button:hover {\n    transform: scale(1.06);\n    background: rgba(0, 0, 0, 0.58);\n  }\n\n  .df-video-card.is-playing .df-play-button {\n    opacity: 0;\n    pointer-events: none;\n  }\n\n  @media screen and (max-width: 749px) {\n    .df-video-testimonials {\n      padding: 54px 0;\n    }\n\n    .df-video-inner {\n      padding: 0 16px;\n    }\n\n    .df-video-header {\n      margin-bottom: 28px;\n    }\n\n    .df-video-header h2 {\n      font-size: 32px;\n      letter-spacing: -1px;\n    }\n\n    .df-video-header p {\n      font-size: 14.5px;\n    }\n\n    .df-video-grid {\n      display: flex;\n      gap: 16px;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      padding-bottom: 10px;\n      scrollbar-width: none;\n    }\n\n    