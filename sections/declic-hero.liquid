{%- comment -%}
  Section Hero Déclic Focus
  Fichier : sections/declic-hero.liquid
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

<section class="dh-hero" id="dh-{{ section.id }}">
  <div class="dh-media">
    {%- if section.settings.video_mobile != blank -%}
      <div class="dh-video dh-video--mobile">
        {{ section.settings.video_mobile | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
      </div>
    {%- endif -%}
    {%- if section.settings.video != blank -%}
      <div class="dh-video dh-video--desktop{% if section.settings.video_mobile == blank %} dh-video--all{% endif %}">
        {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
      </div>
    {%- elsif section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: class: 'dh-img', loading: 'eager', widths: '750, 1200, 1800, 2400' }}
    {%- endif -%}
    <div class="dh-overlay"></div>
  </div>

  <div class="dh-content">
    {%- if section.settings.heading != blank -%}
      <h1 class="dh-title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="dh-sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a class="dh-btn" href="{{ section.settings.button_link | default: '/collections/all' }}">
        {{ section.settings.button_label }}
        <span aria-hidden="true">→</span>
      </a>
    {%- endif -%}

    <ul class="dh-trust">
      {%- if section.settings.trust_1 != blank -%}
        <li class="dh-pill">
          <span class="dh-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/></svg>
          </span>
          <span>{{ section.settings.trust_1 }}</span>
        </li>
      {%- endif -%}
      {%- if section.settings.trust_2 != blank -%}
        <li class="dh-pill">
          <span class="dh-stars" aria-label="5 étoiles">★★★★★</span>
          <span>{{ section.settings.trust_2 }}</span>
        </li>
      {%- endif -%}
    </ul>
  </div>
</section>

<style>
  #dh-{{ section.id }} {
    --dh-accent: {{ section.settings.accent }};
    position: relative;
    width: 100%;
    min-height: {{ section.settings.height_desktop }}vh;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
    color: #fff;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    isolation: isolate;
  }
  #dh-{{ section.id }} .dh-media { position: absolute; inset: 0; z-index: -1; }
  #dh-{{ section.id }} .dh-video,
  #dh-{{ section.id }} .dh-video video,
  #dh-{{ section.id }} .dh-img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  #dh-{{ section.id }} .dh-video--mobile { display: none; }

  /* Dégradé : sombre en haut à gauche, transparent vers la droite */
  #dh-{{ section.id }} .dh-overlay {
    position: absolute; inset: 0;
    background:
      linear-gradient(100deg, rgba(10,12,16,{{ section.settings.overlay | divided_by: 100.0 }}) 0%, rgba(10,12,16,{{ section.settings.overlay | divided_by: 160.0 }}) 45%, rgba(10,12,16,0) 75%),
      linear-gradient(180deg, rgba(10,12,16,.35) 0%, rgba(10,12,16,0) 40%);
  }

  #dh-{{ section.id }} .dh-content {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: clamp(56px, 10vh, 120px) clamp(20px, 5vw, 72px) 64px;
  }
  #dh-{{ section.id }} .dh-title {
    margin: 0 0 18px;
    max-width: 13ch;
    font-family: inherit;
    font-weight: 800;
    font-size: clamp(2.4rem, 5.2vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #fff;
    text-wrap: balance;
    text-shadow: 0 2px 24px rgba(0,0,0,.25);
  }
  #dh-{{ section.id }} .dh-sub {
    margin: 0 0 30px;
    max-width: 40ch;
    font-family: inherit;
    font-weight: 500;
    font-size: clamp(1.02rem, 1.35vw, 1.25rem);
    line-height: 1.55;
    color: rgba(255,255,255,.88);
  }
  #dh-{{ section.id }} .dh-btn {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 16px 30px;
    border-radius: 999px;
    background: var(--dh-accent);
    color: #fff;
    font-family: inherit; font-weight: 700; font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(0,0,0,.25);
    transition: transform .2s ease, box-shadow .2s ease;
  }
  #dh-{{ section.id }} .dh-btn:hover { transform: translateY(-2px); box-shadow: 0 14px 34px rgba(0,0,0,.32); }
  #dh-{{ section.id }} .dh-btn span { transition: transform .2s ease; }
  #dh-{{ section.id }} .dh-btn:hover span { transform: translateX(4px); }

  #dh-{{ section.id }} .dh-trust {
    list-style: none; margin: clamp(110px, 24vh, 280px) 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 10px;
  }
  #dh-{{ section.id }} .dh-pill {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 10px 16px;
    border-radius: 999px;
    background: rgba(255,255,255,.12);
    border: 1px solid rgba(255,255,255,.22);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-size: .92rem; font-weight: 600; line-height: 1.3;
    color: #fff;
  }
  #dh-{{ section.id }} .dh-icon { display: inline-flex; color: #FFD166; }
  #dh-{{ section.id }} .dh-stars { color: #34D399; letter-spacing: 1px; font-size: .95rem; }

  /* Apparition douce */
  #dh-{{ section.id }} .dh-title,
  #dh-{{ section.id }} .dh-sub,
  #dh-{{ section.id }} .dh-btn,
  #dh-{{ section.id }} .dh-trust {
    opacity: 0; transform: translateY(14px);
    animation: dhIn .8s cubic-bezier(.2,.7,.2,1) forwards;
  }
  #dh-{{ section.id }} .dh-sub { animation-delay: .12s; }
  #dh-{{ section.id }} .dh-btn { animation-delay: .24s; }
  #dh-{{ section.id }} .dh-trust { animation-delay: .36s; }
  @keyframes dhIn { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    #dh-{{ section.id }} .dh-title,
    #dh-{{ section.id }} .dh-sub,
    #dh-{{ section.id }} .dh-btn,
    #dh-{{ section.id }} .dh-trust { opacity: 1; transform: none; animation: none; }
  }
  #dh-{{ section.id }} .dh-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  @media (max-width: 749px) {
    #dh-{{ section.id }} { min-height: {{ section.settings.height_mobile }}svh; }
    #dh-{{ section.id }} .dh-video--mobile { display: block; }
    #dh-{{ section.id }} .dh-video--desktop { display: none; }
    #dh-{{ section.id }} .dh-video--all { display: block; }
    #dh-{{ section.id }} .dh-overlay {
      background: linear-gradient(180deg, rgba(10,12,16,{{ section.settings.overlay | divided_by: 100.0 }}) 0%, rgba(10,12,16,{{ section.settings.overlay | divided_by: 200.0 }}) 55%, rgba(10,12,16,.15) 100%);
    }
    #dh-{{ section.id }} .dh-content { padding-top: 44px; }
    #dh-{{ section.id }} .dh-title { max-width: 12ch; }
    #dh-{{ section.id }} .dh-btn { width: 100%; justify-content: center; }
    #dh-{{ section.id }} .dh-pill { font-size: .85rem; padding: 9px 14px; }
  }
</style>

{% schema %}
{
  "name": "Hero Déclic Focus",
  "tag": "div",
  "class": "section-dh-hero",
  "settings": [
    { "type": "header", "content": "Média" },
    { "type": "video", "id": "video", "label": "Vidéo ordinateur" },
    { "type": "video", "id": "video_mobile", "label": "Vidéo mobile (optionnel)" },
    { "type": "image_picker", "id": "image", "label": "Image (si pas de vidéo)" },
    { "type": "range", "id": "overlay", "label": "Assombrissement", "min": 20, "max": 90, "step": 5, "unit": "%", "default": 65 },
    { "type": "range", "id": "height_desktop", "label": "Hauteur ordinateur", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 85 },
    { "type": "range", "id": "height_mobile", "label": "Hauteur mobile", "min": 50, "max": 100, "step": 5, "unit": "vh", "default": 80 },

    { "type": "header", "content": "Texte" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ne remets plus ta vie à demain." },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Avec Déclic Focus, lance tes tâches, avance sur l’essentiel et reprends ton temps." },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Je passe à l’action" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton" },
    { "type": "color", "id": "accent", "label": "Couleur du bouton", "default": "#1F8A70" },

    { "type": "header", "content": "Confiance" },
    { "type": "text", "id": "trust_1", "label": "Badge 1", "default": "Élu outil de productivité n°1 en 2022" },
    { "type": "text", "id": "trust_2", "label": "Badge 2", "default": "+4 500 personnes utilisent déjà Déclic Focus" }
  ],
  "presets": [{ "name": "Hero Déclic Focus" }]
}
{% endschema %}
